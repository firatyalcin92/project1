{
  "expo": {
    "name": "Hopdog",
    "slug": "hopdog",
    "version": "0.1.0",
    "scheme": "hopdog",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3efe8",
    "ios": {
      "bundleIdentifier": "com.firatyalcin.hopdog",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.firatyalcin.hopdog",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe8",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "owner": "firatyalcin",
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1de21188-23b7-4522-b498-3680fd473632"
      }
    }
  }
}
