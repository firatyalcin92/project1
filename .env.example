# ---------------------------------------------------------------------------
# MESELE ortam değişkenleri — bu dosyayı .env olarak kopyalayın.
# Hiçbiri VITE_ önekiyle başlamaz (VITE_COUNSELOR_URL hariç): sırlar istemciye gitmez.
# ---------------------------------------------------------------------------

# --- Veritabanı (Supabase / Lovable Cloud) ---
# Tanımlı değilse geliştirme ortamında bellek içi depo kullanılır (veriler yeniden başlatınca silinir).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Testte/demoda Supabase'i atlayıp bellek deposunu zorlamak için:
# MESELE_STORE=memory

# --- AI sağlayıcısı (birini seçin) ---
# Doğrudan OpenAI:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Lovable AI Gateway (Lovable Cloud projelerinde otomatik tanımlanır):
# LOVABLE_API_KEY=
# İkisi de varsa OpenAI kullanılır; açıkça seçmek için: openai | lovable | mock
# MESELE_AI_PROVIDER=openai

# Modeller (varsayılanlar: OpenAI gpt-4o / gpt-4o-mini, Lovable openai/gpt-5-mini)
# MESELE_AI_MODEL=gpt-4o
# MESELE_AI_MODEL_FAST=gpt-4o-mini
# Katı şema desteklemeyen bir model/ağ geçidi için: json_object
# MESELE_AI_STRUCTURED=json_schema
# MESELE_AI_TEMPERATURE=0.7
# MESELE_AI_TIMEOUT_MS=120000

# --- İsteğe bağlı ---
# Çözüm raporunun altında "danışmanla görüşme" bağlantısı (istemciye açıktır):
# VITE_COUNSELOR_URL=https://firatyalcin.com/randevu
# Capacitor kabuğunun açacağı yayınlanmış adres:
# MESELE_APP_URL=https://mesele.example.com
