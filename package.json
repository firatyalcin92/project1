{
  "name": "mesele",
  "private": true,
  "version": "0.1.0",
  "description": "MESELE: Bir tartışmayı anlamanın daha iyi bir yolu.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:lan": "vite dev --port 3000 --host",
    "build": "vite build && npm run hopla:build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "assets": "npx -y -p playwright@1.56.1 node scripts/generate-assets.mjs",
    "format": "npx -y prettier@3.8.1 --write .",
    "setup": "node scripts/setup-env.mjs",
    "paket:cpanel": "node scripts/cpanel-paket.mjs",
    "test:sqlite": "MESELE_TEST_STORE=sqlite vitest run tests/flow.test.ts",
    "hopla:dev": "vite --config hopla/web/vite.config.ts",
    "hopla:build": "vite build --config hopla/web/vite.config.ts",
    "hopla:native": "vite build --config hopla/web/vite.config.ts --mode native",
    "hopla:icons": "node hopla/scripts/icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.103.3",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "srvx": "0.11.22",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
